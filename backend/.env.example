# --- App ---
ENVIRONMENT=development

# --- Auth / JWT ---
JWT_SECRET_KEY=

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Database (Supabase Postgres) ---
# format: postgresql+psycopg://postgres:<password>@<host>:5432/postgres
DATABASE_URL=

# --- Redis (Upstash) ---
# format: rediss://default:<token>@<host>:6379   (note the double "s" — TLS)
REDIS_URL=

# --- LLM ---
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# --- Storage (Supabase Storage or AWS S3) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=
S3_ENDPOINT_URL=